{
  "scopeName": "source.splash",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#colors"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#enums"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.splash",
          "match": "//.*$"
        },
        {
          "name": "comment.block.splash",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.splash",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.splash",
          "match": "\\\\."
        }
      ]
    },
    "colors": {
      "name": "constant.other.color.splash",
      "match": "#[xX]?[0-9a-fA-F]{3,8}\\b"
    },
    "numbers": {
      "name": "constant.numeric.splash",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.splash",
          "match": "\\b(if|else|for|in|while|return|break|continue|do|use|mod|let|fn)\\b"
        },
        {
          "name": "constant.language.splash",
          "match": "\\b(nil|true|false)\\b"
        }
      ]
    },
    "enums": {
      "patterns": [
        {
          "name": "constant.other.enum.splash",
          "match": "(?<![A-Za-z0-9_])\\.[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "([A-Z][A-Za-z0-9_]*)(\\.[A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.splash"
            },
            "2": {
              "name": "constant.other.enum.splash"
            }
          }
        }
      ]
    },
    "types": {
      "name": "entity.name.type.splash",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "calls": {
      "name": "entity.name.function.splash",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "properties": {
      "name": "variable.other.property.splash",
      "match": "\\b[a-z_][A-Za-z0-9_]*(\\s*:(?!:|=))"
    },
    "operators": {
      "name": "keyword.operator.splash",
      "match": ":=\\\\|\\+=\\|-=\\|\\*=\\|/=\\|==|!=|<=|>=|&&\\\\|\\|\\|[+\\-*/%=]"
    }
  }
}
